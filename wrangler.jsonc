{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mars-frontier",
  "main": "worker/index.ts",
  // compatibility_flags live in vite.config.ts only: the two configs are merged
  // and declaring nodejs_compat in both stops the runtime from starting.
  "compatibility_date": "2025-06-01",
  "assets": {
    "directory": "dist/client",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  // One Durable Object per room. The room owns the authoritative game state and
  // pushes each player their own filtered view over a WebSocket.
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOMS",
        "class_name": "GameRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["GameRoom"]
    }
  ]
}
